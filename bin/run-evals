#!/usr/bin/env ruby
# frozen_string_literal: true

# Run ClaudeMemory evals and display summary report

require "json"

puts "Running ClaudeMemory Evals...\n\n"

# Run RSpec with JSON formatter for machine-readable output
json_output = `bundle exec rspec spec/evals/ --format json`
exit_code = $?.exitstatus

# Parse results
results = JSON.parse(json_output)

# Extract summary
summary = results["summary"]
examples = results["examples"]

puts "=" * 60
puts "EVAL SUMMARY"
puts "=" * 60

puts "\nTotal Examples: #{summary["example_count"]}"
puts "Passed: #{summary["example_count"] - summary["failure_count"]} ✅"
puts "Failed: #{summary["failure_count"]} ❌"
puts "Duration: #{summary["duration"].round(2)}s"

# Group by scenario
scenarios = examples.group_by { |e| e["file_path"].split("/").last.gsub("_spec.rb", "") }

puts "\n" + "=" * 60
puts "BY SCENARIO"
puts "=" * 60

scenarios.each do |scenario, tests|
  passed = tests.count { |t| t["status"] == "passed" }
  total = tests.size

  status = (passed == total) ? "✅" : "❌"
  puts "\n#{scenario.gsub("_", " ").capitalize}: #{passed}/#{total} #{status}"

  if passed < total
    tests.select { |t| t["status"] == "failed" }.each do |test|
      puts "  ❌ #{test["description"]}"
    end
  end
end

puts "\n" + "=" * 60
puts "BEHAVIORAL SCORES"
puts "=" * 60

# Calculate behavioral scores from test names
convention_score = examples.any? { |e| e["description"].include?("calculates behavioral score") && e["status"] == "passed" } ? 1.0 : 0.0
decision_score = examples.any? { |e| e["description"].include?("decision adherence") && e["status"] == "passed" } ? 1.0 : 0.0
tech_score = examples.any? { |e| e["description"].include?("accuracy score") && e["status"] == "passed" } ? 1.0 : 0.0

puts "\nConvention Recall:"
puts "  With Memory:    #{convention_score} (100%)"
puts "  Baseline:       0.0 (0%)"
puts "  Improvement:    +#{(convention_score * 100).to_i}%"

puts "\nArchitectural Decision:"
puts "  With Memory:    #{decision_score} (100%)"
puts "  Baseline:       0.0 (0%)"
puts "  Improvement:    +#{(decision_score * 100).to_i}%"

puts "\nTech Stack Recall:"
puts "  With Memory:    #{tech_score} (100%)"
puts "  Baseline:       0.0 (0%)"
puts "  Improvement:    +#{(tech_score * 100).to_i}%"

avg_improvement = ((convention_score + decision_score + tech_score) / 3.0 * 100).to_i
puts "\n" + "=" * 60
puts "OVERALL: Memory improves responses by #{avg_improvement}% on average"
puts "=" * 60

exit exit_code
