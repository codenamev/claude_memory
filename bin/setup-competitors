#!/usr/bin/env bash
set -euo pipefail

# Install competitor tools (QMD + grepai) for comparative benchmarks.
# Idempotent — safe to re-run. Downloads ~3GB total on first run.
#
# Usage:
#   bin/setup-competitors              # Install everything
#   bin/setup-competitors --qmd-only   # Only QMD + Bun
#   bin/setup-competitors --grepai-only # Only grepai + Ollama
#   bin/setup-competitors --check      # Report what's installed
#   bin/setup-competitors --yes        # Skip confirmations

# === Utility functions ===

info()    { printf "\033[1;34m[INFO]\033[0m %s\n" "$1"; }
success() { printf "\033[1;32m[OK]\033[0m   %s\n" "$1"; }
warn()    { printf "\033[1;33m[WARN]\033[0m %s\n" "$1"; }
error()   { printf "\033[1;31m[ERR]\033[0m  %s\n" "$1" >&2; }

check_command() {
  command -v "$1" > /dev/null 2>&1
}

confirm() {
  if [ "${YES:-}" = "1" ]; then return 0; fi
  printf "%s [y/N] " "$1"
  read -r answer
  case "$answer" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

# === Argument parsing ===

QMD_ONLY=0
GREPAI_ONLY=0
CHECK_ONLY=0
YES=0

for arg in "$@"; do
  case "$arg" in
    --qmd-only)    QMD_ONLY=1 ;;
    --grepai-only) GREPAI_ONLY=1 ;;
    --check)       CHECK_ONLY=1 ;;
    --yes|-y)      YES=1 ;;
    --help|-h)
      echo "Usage: bin/setup-competitors [OPTIONS]"
      echo ""
      echo "Install competitor tools for comparative benchmarks."
      echo ""
      echo "Options:"
      echo "  --qmd-only      Only install QMD + Bun"
      echo "  --grepai-only   Only install grepai + Ollama"
      echo "  --check         Report what's installed (no changes)"
      echo "  --yes, -y       Skip confirmations"
      echo "  --help, -h      Show this help"
      exit 0
      ;;
    *)
      error "Unknown argument: $arg"
      exit 1
      ;;
  esac
done

# Ensure bun PATH is available for all modes
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$PATH"

INSTALL_QMD=1
INSTALL_GREPAI=1

if [ "$QMD_ONLY" = "1" ]; then INSTALL_GREPAI=0; fi
if [ "$GREPAI_ONLY" = "1" ]; then INSTALL_QMD=0; fi

# === Check mode ===

if [ "$CHECK_ONLY" = "1" ]; then
  echo "=== Competitor Tool Status ==="
  echo ""

  echo "QMD:"
  if check_command bun; then
    echo "  Bun:  $(bun --version)"
  else
    echo "  Bun:  not installed"
  fi
  if check_command qmd; then
    echo "  QMD:  installed ($(which qmd))"
  else
    echo "  QMD:  not installed"
  fi

  echo ""
  echo "grepai:"
  if check_command ollama; then
    echo "  Ollama: $(ollama --version 2>/dev/null || echo "installed")"
    if curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; then
      echo "  Ollama server: running"
      if ollama list 2>/dev/null | grep "nomic-embed-text" > /dev/null 2>&1; then
        echo "  nomic-embed-text: pulled"
      else
        echo "  nomic-embed-text: not pulled"
      fi
    else
      echo "  Ollama server: not running"
    fi
  else
    echo "  Ollama: not installed"
  fi
  if check_command grepai; then
    echo "  grepai: installed ($(which grepai))"
  else
    echo "  grepai: not installed"
  fi

  exit 0
fi

# === Size warnings ===

echo "=== Comparative Benchmark Setup ==="
echo ""

if [ "$INSTALL_QMD" = "1" ]; then
  echo "QMD installation will download:"
  echo "  - Bun runtime (~30MB)"
  echo "  - QMD package (~5MB)"
  echo "  - GGUF models on first use (~2GB)"
  echo ""
fi

if [ "$INSTALL_GREPAI" = "1" ]; then
  echo "grepai installation will download:"
  echo "  - Ollama (~500MB)"
  echo "  - nomic-embed-text model (~274MB)"
  echo "  - grepai binary (~15MB)"
  echo ""
fi

if ! confirm "Continue with installation?"; then
  echo "Aborted."
  exit 0
fi

# ============================================================
# QMD
# ============================================================

install_bun() {
  if check_command bun; then
    success "Bun already installed ($(bun --version))"
    return 0
  fi

  info "Installing Bun..."
  curl -fsSL https://bun.sh/install | bash

  # Add to PATH for this session
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$PATH"

  if check_command bun; then
    success "Bun installed ($(bun --version))"
  else
    error "Bun installation failed"
    return 1
  fi
}

install_qmd() {
  # Ensure bun PATH is available
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$PATH"

  if check_command qmd; then
    success "QMD already installed ($(which qmd))"
    return 0
  fi

  info "Installing QMD via Bun..."
  bun install -g https://github.com/tobi/qmd

  if check_command qmd; then
    success "QMD installed ($(which qmd))"
  else
    error "QMD installation failed"
    return 1
  fi
}

warm_qmd_models() {
  info "Warming QMD models (this downloads ~2GB on first run)..."
  if qmd status 2>/dev/null; then
    success "QMD models ready"
  else
    warn "QMD status returned non-zero (models may still be downloading)"
    warn "Run 'qmd status' manually to check progress"
  fi
}

verify_qmd() {
  info "Verifying QMD installation..."

  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" RETURN

  local docs_dir="$tmpdir/docs"
  mkdir -p "$docs_dir"

  echo "# Test Document" > "$docs_dir/test.md"
  echo "" >> "$docs_dir/test.md"
  echo "This is a test document about Ruby programming." >> "$docs_dir/test.md"

  # Add collection, embed, and query
  if qmd collection add "$docs_dir" --name benchmark-verify 2>/dev/null; then
    if qmd embed 2>/dev/null; then
      local result
      result=$(qmd search -n 1 "Ruby" 2>/dev/null || true)
      if [ -n "$result" ]; then
        success "QMD verification passed"
      else
        warn "QMD search returned empty (may need model warmup)"
      fi
    else
      warn "QMD embed failed (models may need downloading)"
    fi
    # Clean up collection
    qmd collection remove benchmark-verify 2>/dev/null || true
  else
    warn "QMD collection add failed"
  fi
}

# ============================================================
# GREPAI
# ============================================================

install_ollama() {
  if check_command ollama; then
    success "Ollama already installed"
    return 0
  fi

  info "Installing Ollama..."
  case "$(uname -s)" in
    Darwin)
      if check_command brew; then
        brew install ollama
      else
        error "Homebrew not found. Install Ollama manually: https://ollama.ai"
        return 1
      fi
      ;;
    Linux)
      curl -fsSL https://ollama.ai/install.sh | sh
      ;;
    *)
      error "Unsupported OS: $(uname -s)"
      return 1
      ;;
  esac

  if check_command ollama; then
    success "Ollama installed"
  else
    error "Ollama installation failed"
    return 1
  fi
}

ensure_ollama_running() {
  if curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; then
    success "Ollama server is running"
    return 0
  fi

  info "Starting Ollama server..."
  ollama serve &
  local ollama_pid=$!

  # Wait up to 15 seconds for server to start
  local deadline=$((SECONDS + 15))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; then
      success "Ollama server started (PID $ollama_pid)"
      return 0
    fi
    sleep 1
  done

  error "Ollama server failed to start within 15 seconds"
  return 1
}

pull_embedding_model() {
  if ollama list 2>/dev/null | grep "nomic-embed-text" > /dev/null 2>&1; then
    success "nomic-embed-text model already pulled"
    return 0
  fi

  info "Pulling nomic-embed-text model (~274MB)..."
  ollama pull nomic-embed-text

  if ollama list 2>/dev/null | grep "nomic-embed-text" > /dev/null 2>&1; then
    success "nomic-embed-text model pulled"
  else
    error "Failed to pull nomic-embed-text"
    return 1
  fi
}

install_grepai() {
  if check_command grepai; then
    success "grepai already installed ($(which grepai))"
    return 0
  fi

  info "Installing grepai..."
  case "$(uname -s)" in
    Darwin)
      if check_command brew; then
        brew install yoanbernabeu/tap/grepai
      else
        error "Homebrew not found. Install grepai manually: https://github.com/yoanbernabeu/grepai"
        return 1
      fi
      ;;
    Linux)
      # Try Homebrew first, fall back to Go install
      if check_command brew; then
        brew install yoanbernabeu/tap/grepai
      elif check_command go; then
        go install github.com/yoanbernabeu/grepai/cmd/grepai@latest
      else
        error "Neither Homebrew nor Go found. Install grepai manually."
        return 1
      fi
      ;;
    *)
      error "Unsupported OS: $(uname -s)"
      return 1
      ;;
  esac

  if check_command grepai; then
    success "grepai installed ($(which grepai))"
  else
    error "grepai installation failed"
    return 1
  fi
}

verify_grepai() {
  info "Verifying grepai installation..."

  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" RETURN

  mkdir -p "$tmpdir/src"
  echo "# Ruby programming test file" > "$tmpdir/src/test.rb"
  echo "def hello; puts 'world'; end" >> "$tmpdir/src/test.rb"

  # Create config for GOB backend with Ollama
  mkdir -p "$tmpdir/.grepai"
  cat > "$tmpdir/.grepai/config.yaml" << 'YAML'
store:
  backend: gob
embedder:
  provider: ollama
  model: nomic-embed-text
  endpoint: http://localhost:11434
YAML

  cd "$tmpdir"

  # Run grepai search (it should auto-index on first search)
  local result
  result=$(grepai search "Ruby programming" -n 1 2>/dev/null || true)
  if [ -n "$result" ]; then
    success "grepai verification passed"
  else
    warn "grepai search returned empty (may need indexing first)"
  fi

  cd - > /dev/null
}

# ============================================================
# MAIN
# ============================================================

qmd_status=0
grepai_status=0

if [ "$INSTALL_QMD" = "1" ]; then
  echo ""
  echo "=== Installing QMD ==="
  echo ""
  install_bun || qmd_status=1
  if [ "$qmd_status" = "0" ]; then
    install_qmd || qmd_status=1
  fi
  if [ "$qmd_status" = "0" ]; then
    warm_qmd_models || true  # Non-fatal
  fi
  if [ "$qmd_status" = "0" ]; then
    verify_qmd || true  # Non-fatal
  fi
fi

if [ "$INSTALL_GREPAI" = "1" ]; then
  echo ""
  echo "=== Installing grepai ==="
  echo ""
  install_ollama || grepai_status=1
  if [ "$grepai_status" = "0" ]; then
    ensure_ollama_running || grepai_status=1
  fi
  if [ "$grepai_status" = "0" ]; then
    pull_embedding_model || grepai_status=1
  fi
  if [ "$grepai_status" = "0" ]; then
    install_grepai || grepai_status=1
  fi
  if [ "$grepai_status" = "0" ]; then
    verify_grepai || true  # Non-fatal
  fi
fi

# === Summary ===

echo ""
echo "=== Setup Summary ==="

if [ "$INSTALL_QMD" = "1" ]; then
  if [ "$qmd_status" = "0" ]; then
    success "QMD: ready"
  else
    error "QMD: installation failed"
  fi
fi

if [ "$INSTALL_GREPAI" = "1" ]; then
  if [ "$grepai_status" = "0" ]; then
    success "grepai: ready"
  else
    error "grepai: installation failed"
  fi
fi

echo ""
echo "Run 'bin/setup-competitors --check' to verify status."
echo "Run 'bin/run-evals --comparative' to run benchmarks."

exit $((qmd_status + grepai_status))
