/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# mise artifacts
mise.toml

# rspec failure tracking
.rspec_status
.claude/settings*.json

# Project memory DB — per-developer dogfooding state, not a repo artifact.
# The curated, reproducible memory lives in the tracked snapshot
# .claude/rules/claude_memory.generated.md; the raw DB re-pollutes every
# session, isn't shipped in the gem (gemspec excludes .claude/), and its LFS
# blobs don't survive on the remote. Tracking it only caused dirty-tree
# friction at release time. (Reverses the earlier "always commit it" rule.)
.claude/memory.sqlite3

# SQLite WAL/SHM — ephemeral runtime files, recreated on every DB open
*.sqlite3-shm
*.sqlite3-wal

# Pre-recovery snapshots left behind by `sqlite3 .recover` — disposable
# once the live DB has been validated.
*.sqlite3.corrupt

# Pre-compiled gems
*.gem

# Runtime locks (e.g. /loop / scheduled-task harness state)
.claude/scheduled_tasks.lock

# Machine-local session/scratch state — per-developer, not repo artifacts
.claude/auto_memory_mirror.json
.last-session
.dashboard-demo-session
